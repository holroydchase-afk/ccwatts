{
  "name": "ccwatts-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w packages/core -w packages/web -w packages/cli && node scripts/build-plugin.mjs",
    "typecheck": "tsc -p packages/core && tsc -p packages/web && tsc -p packages/cli",
    "test": "node packages/web/build.mjs && vitest run",
    "check:browser": "node scripts/check-no-network.mjs",
    "check:kit": "node tools/showcase-check/selftest.mjs",
    "check:page": "node tools/showcase-check/cli.mjs",
    "start": "npm run build && node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.27.7",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
