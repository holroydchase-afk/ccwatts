# The tree's text style, for any editor (https://editorconfig.org). packages/cli/test/repo-hygiene.test.ts (HYG-5) checks it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[plugins/ccwatts/bin/*.js]
# Generated by esbuild (npm run build); left as it writes them.
indent_size = unset
trim_trailing_whitespace = unset

[packages/web/src/fonts/OFL.txt]
# The font's license, kept exactly as its authors ship it.
trim_trailing_whitespace = unset
